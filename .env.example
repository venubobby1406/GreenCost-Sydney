TAVILY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional frontend proxy override for running alongside an existing server.
# GREENCOST_API_URL=http://127.0.0.1:8000
# Local PDF retrieval requires no database or model download.
SAVE_LOCAL_ANALYSES=true
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
REQUESTS_PER_MINUTE=120
TAVILY_DAILY_CAP=10
TAVILY_MONTHLY_CAP=200
GEMINI_DAILY_CAP=20
GEMINI_MONTHLY_CAP=400
# Vercel defaults to offline mode. Free-tier keys can be enabled explicitly.
# Per-instance counters cannot enforce a shared quota across serverless instances.
# Keep provider account quotas in place before enabling this.
ENABLE_HOSTED_AI=false
LANGSMITH_TRACING=false
NEXT_TELEMETRY_DISABLED=1
